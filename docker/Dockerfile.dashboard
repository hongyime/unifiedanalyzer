FROM node:22-alpine AS frontend-dependencies
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM frontend-dependencies AS frontend-dev
RUN chown -R node:node /app/frontend
USER node
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

FROM frontend-dependencies AS frontend-build
COPY frontend/ ./
RUN npm run build

FROM pgvector/pgvector:pg16 AS postgres-tools

# Preserve upstream CPU-only dependencies and matching database backup tools.
FROM python:3.12-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
COPY docker/constraints-cpu.txt /app/constraints-cpu.txt
ENV PIP_CONSTRAINT=/app/constraints-cpu.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch==2.11.0+cpu --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m spacy download en_core_web_trf && python -m pip check

FROM python:3.12-slim AS dependencies
ENV PATH="/opt/venv/bin:${PATH}" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 libxcb1 libgomp1 ffmpeg tesseract-ocr postgresql-client \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
COPY --from=postgres-tools /usr/lib/postgresql/16/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=postgres-tools /usr/lib/postgresql/16/bin/pg_restore /usr/local/bin/pg_restore

RUN useradd -u 1001 -m appuser \
    && mkdir -p /app/data /app/backups /app/logs /home/appuser/.cache \
    && chown -R appuser:appuser /app /home/appuser

FROM dependencies AS dev
RUN pip install --no-cache-dir watchfiles==1.3.0
USER appuser
EXPOSE 8002
CMD ["watchfiles", "--target-type", "command", "python -m src.main serve", "/app/src"]

FROM dependencies AS production
COPY src/ src/
COPY --chown=appuser:appuser data/ data/
COPY --from=frontend-build /app/frontend/dist/ frontend/dist/
COPY docker/embed-backfill-loop.sh /app/embed-backfill-loop.sh
RUN chmod +x /app/embed-backfill-loop.sh
USER appuser
EXPOSE 8002
CMD ["python", "-m", "src.main", "serve"]
LABEL io.unifiedanalyzer.project="unifiedanalyzer"
