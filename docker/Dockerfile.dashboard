# Dashboard image: builds the React frontend, then serves API + static build
# from one python:3.12-slim container on port 8001 (same port as the analyzer
# `serve` process — see src/main.py / API_PORT).
#
# Stage 1 — build the Vite frontend to frontend/dist.
FROM node:22-slim AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2 — python API serving the built frontend as static files.
FROM python:3.12-slim
WORKDIR /app

# System libs + binaries for the full Phase 6 media stack:
#  - libglib2.0-0 libgl1 : OpenCV / Pillow runtime (thumbnails + face detect)
#  - ffmpeg              : 6H sparse video-frame extraction
#  - tesseract-ocr       : 6D image/PDF OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 ffmpeg tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# NER enrichment (src/pipeline/entity_enrichment.py) — the transformer model
# is ~450MB plus torch ~700MB. Bakes into the image so the scheduler doesn't
# hit the network on first run.
RUN python -m spacy download en_core_web_trf

COPY src/ src/
COPY --from=frontend /app/frontend/dist/ frontend/dist/
COPY docker/embed-backfill-loop.sh /app/embed-backfill-loop.sh
RUN chmod +x /app/embed-backfill-loop.sh

# Port comes from API_PORT (.env -> 8002); the entrypoint honors it and also
# starts the scheduler via the app lifespan. EXPOSE is documentation only.
EXPOSE 8002

CMD ["python", "-m", "src.main", "serve"]
