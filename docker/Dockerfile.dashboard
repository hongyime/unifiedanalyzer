# Dashboard image: builds the React frontend, then serves API + static build
# from one python:3.12-slim container on port 8001 (same port as the analyzer
# `serve` process — see src/main.py / API_PORT).
#
# Stage 1 — build the Vite frontend to frontend/dist.
FROM node:22-slim AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM pgvector/pgvector:pg16 AS postgres-tools

# Stage 2 — build CPU-only Python dependencies separately from runtime tools.
FROM python:3.12-slim AS dependencies
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY docker/constraints-cpu.txt /app/constraints-cpu.txt
ENV PIP_CONSTRAINT=/app/constraints-cpu.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch==2.11.0+cpu --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m spacy download en_core_web_trf && python -m pip check

# Stage 3 — Python API and media runtime without compiler tooling.
FROM python:3.12-slim
WORKDIR /app

# System libs + binaries for the full Phase 6 media stack:
#  - libglib2.0-0 libgl1 : OpenCV / Pillow runtime (thumbnails + face detect)
#  - ffmpeg              : 6H sparse video-frame extraction
#  - tesseract-ocr       : 6D image/PDF OCR
#  - postgresql-client   : pg_dump for analyzer DB backups
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 libxcb1 libgomp1 ffmpeg tesseract-ocr postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=dependencies /usr/local/ /usr/local/
COPY --from=postgres-tools /usr/lib/postgresql/16/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=postgres-tools /usr/lib/postgresql/16/bin/pg_restore /usr/local/bin/pg_restore

COPY src/ src/
COPY data/ data/
COPY --from=frontend /app/frontend/dist/ frontend/dist/
COPY docker/embed-backfill-loop.sh /app/embed-backfill-loop.sh
RUN chmod +x /app/embed-backfill-loop.sh

# Port comes from API_PORT (.env -> 8002); the entrypoint honors it and also
# starts the scheduler via the app lifespan. EXPOSE is documentation only.
EXPOSE 8002

CMD ["python", "-m", "src.main", "serve"]
LABEL io.unifiedanalyzer.project="unifiedanalyzer"
