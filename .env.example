# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
ANALYZER_DATABASE_URL=postgres://collector:collector@localhost:5500/unifiedanalyzer
COLLECTOR_DATABASE_URL=postgres://collector:collector@localhost:5500/unifiedcollector
DB_MAX_POOL_SIZE=10

# ─────────────────────────────────────────────
# SCHEDULER CADENCES
# ─────────────────────────────────────────────
INCREMENTAL_RUN_INTERVAL_MINUTES=60
FULL_RESOLUTION_HOUR=3
GAP_DETECTION_HOUR=6

# ─────────────────────────────────────────────
# IDENTITY RESOLUTION
# ─────────────────────────────────────────────
IDENTITY_CONFIDENCE_THRESHOLD=0.85
IDENTITY_MIN_SIGNALS=2
USERNAME_NORMALIZE_STRIP_CHARS=._-
USERNAME_NORMALIZE_STRIP_TRAILING_DIGITS=true
NAME_FUZZY_MIN_SCORE=85

# ─────────────────────────────────────────────
# IDENTITY CALIBRATION (LR model + auto-label seeder)
# ─────────────────────────────────────────────
# Safety gate: even if a trained model file exists on disk (from `train-db`
# or the retrain phase), the scorer only auto-loads it when this is '1'. Flip
# to '1' only after `python -m src.pipeline.identity_calibration validate`
# shows the LR beats noisy-OR on your labeled set. Default '0' (noisy-OR).
IDENTITY_MODEL_ENABLED=0
# Retrain threshold (min identity_labels rows before maybe_retrain trains).
# Lower to activate calibration earlier — the current live DB has 15 human
# labels (4 pos + 11 neg), so IDENTITY_MIN_LABELS=15 will train immediately.
IDENTITY_MIN_LABELS=20
# Retrain cadence: retrain once this many NEW labels have accumulated since
# the last successful training (post-threshold).
IDENTITY_RETRAIN_EVERY=10
# Auto-label seeder (src/pipeline/auto_labeler.py): enables the pipeline
# phase that INSERTs auto_positive_v1 rows for pairs with signal confluence
# (>=2 signal types, at least one hard-anchor). Idempotent, never overwrites
# human labels. As of 2026-07-05 the live dataset produces 0 auto-labels
# (all 254 candidate pairs fire on only 1 signal type) — the code activates
# automatically as data grows.
AUTO_LABEL_ENABLED=0

# ─────────────────────────────────────────────
# ALERT RULES
# ─────────────────────────────────────────────
SILENCE_GAP_DYNAMIC=true
SILENCE_GAP_MIN_HISTORY_DAYS=14
SILENCE_GAP_FIXED_DAYS=7
SILENCE_GAP_DYNAMIC_MULTIPLIER=2.5
SILENCE_GAP_MIN_DAYS=3
SILENCE_GAP_MAX_DAYS=30

NEW_ACTIVITY_AFTER_SILENCE_ENABLED=true
NEW_ACTIVITY_EVENT_TYPES=CONTENT_PUBLISHED,MESSAGE_SENT,PHYSICAL_ACTIVITY,CODE_COMMIT,VIDEO_PUBLISHED

PROFILE_CHANGE_ALERT_ENABLED=true

# ─────────────────────────────────────────────
# API / UI
# ─────────────────────────────────────────────
# The docker stack publishes the dashboard on host port 8002 (8001 is the
# collector dashboard). Set API_PORT=8002 to match docker/docker-compose.yml.
API_PORT=8002
API_HOST=0.0.0.0

# ─────────────────────────────────────────────
# DRIVE FACE-SCANNING (face_worker)
# ─────────────────────────────────────────────
# SMB credentials for the W:/X: network drives (Tailscale host Prawn-E14),
# consumed by the CIFS volumes in docker/docker-compose.yml. Keep real values
# only in .env (gitignored), never here. NOTE: DRIVE_SOURCES / EXCLUDE_PATHS are
# set directly in the compose file, not here. C: must NEVER be a drive source
# (reading OneDrive placeholders hydrates them and fills the disk).
SMB_HOST=100.92.164.125
SMB_USER=you@example.com
SMB_PASS=changeme
# Drive-scan cadence inside the face_worker loop:
FACE_WORKER_DRIVE_BATCH=200
FACE_WORKER_DRIVE_INTERVAL=3600

# ─────────────────────────────────────────────
# FACE_WORKER CPU CONTAINMENT (shared box)
# ─────────────────────────────────────────────
# face_worker is the heaviest CPU consumer; these keep it from saturating a box
# shared with the collector stack. Applied via docker-compose (recreate, no
# rebuild needed for the compose knobs).
FACE_WORKER_MAX_CPUS=2.0   # hard cgroup ceiling (cores) — the guaranteed cap
FACE_WORKER_THREADS=2      # OMP/MKL/OpenBLAS/numexpr thread cap
FACE_ONNX_THREADS=2        # ONNXRuntime intra-op thread cap (read by the detector)
