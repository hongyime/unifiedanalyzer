# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
ANALYZER_DATABASE_URL=postgres://collector:collector@localhost:5500/unifiedanalyzer
COLLECTOR_DATABASE_URL=postgres://collector:collector@localhost:5500/unifiedcollector
DB_MAX_POOL_SIZE=10

# Analyzer DB backups. Host/dev runs default to Z:\unifiedanalyzer\backups\db;
# docker-compose overrides ANALYZER_DB_BACKUP_DIR to /app/backups/db and mounts
# that path back to the same Z: directory.
ANALYZER_DB_BACKUP_ENABLED=1
# ANALYZER_DB_BACKUP_DIR=Z:\unifiedanalyzer\backups\db
ANALYZER_DB_BACKUP_HOUR_UTC=2
ANALYZER_DB_BACKUP_RETENTION_DAILY=7
ANALYZER_DB_BACKUP_RETENTION_WEEKLY=4
ANALYZER_DB_BACKUP_RETENTION_MONTHLY=3
# PG_DUMP_BIN=pg_dump

# Analyzer human decision logs. Docker overrides this to /app/decisions and
# bind-mounts it to Z:\unifiedanalyzer\decisions.
# ANALYZER_DECISION_LOG_DIR=Z:\unifiedanalyzer\decisions

# ─────────────────────────────────────────────
# SCHEDULER CADENCES
# ─────────────────────────────────────────────
INCREMENTAL_RUN_INTERVAL_MINUTES=60
FULL_RESOLUTION_HOUR=3
GAP_DETECTION_HOUR=6

# ─────────────────────────────────────────────
# IDENTITY RESOLUTION
# ─────────────────────────────────────────────
IDENTITY_CONFIDENCE_THRESHOLD=0.85
IDENTITY_MIN_SIGNALS=2
USERNAME_NORMALIZE_STRIP_CHARS=._-
USERNAME_NORMALIZE_STRIP_TRAILING_DIGITS=true
NAME_FUZZY_MIN_SCORE=85

# ─────────────────────────────────────────────
# IDENTITY CALIBRATION (LR model + auto-label seeder)
# ─────────────────────────────────────────────
# Safety gate: even if a trained model file exists on disk (from `train-db`
# or the retrain phase), the scorer only auto-loads it when this is '1'. Flip
# to '1' only after `python -m src.pipeline.identity_calibration validate`
# shows the LR beats noisy-OR on your labeled set. Default '0' (noisy-OR).
IDENTITY_MODEL_ENABLED=0
# Retrain threshold (min identity_labels rows before maybe_retrain trains).
# Lower to activate calibration earlier — the current live DB has 15 human
# labels (4 pos + 11 neg), so IDENTITY_MIN_LABELS=15 will train immediately.
IDENTITY_MIN_LABELS=20
# Retrain cadence: retrain once this many NEW labels have accumulated since
# the last successful training (post-threshold).
IDENTITY_RETRAIN_EVERY=10
# Auto-label seeder (src/pipeline/auto_labeler.py): enables the pipeline
# phase that INSERTs auto_positive_v1 rows for pairs with signal confluence
# (>=2 signal types, at least one hard-anchor). Idempotent, never overwrites
# human labels. As of 2026-07-05 the live dataset produces 0 auto-labels
# (all 254 candidate pairs fire on only 1 signal type) - the code activates
# automatically as data grows.
AUTO_LABEL_ENABLED=0

# Calibration cutover watchdog (src/pipeline/calibration_watchdog.py).
# Runs at the tail of each pipeline cycle. When identity_labels count >=
# MIN_LABELS AND leave-one-out AUC(LR) - AUC(noisy-OR) >= MIN_DELTA, emits
# a CALIBRATION_READY alert + Telegram notification. Does NOT auto-flip
# IDENTITY_MODEL_ENABLED - operator remains in the loop.
CALIBRATION_MONITOR_MIN_LABELS=50
CALIBRATION_MONITOR_MIN_DELTA=0.05
# Re-alert every ~10 additional labels once we're above the threshold, so a
# slow trickle of merges doesn't spam but a genuinely improving model still
# nudges the operator.
CALIBRATION_MONITOR_RECHECK_STRIDE=10

# ─────────────────────────────────────────────
# TRACK-C OSINT ENRICHMENT (2026-07-08)
# ─────────────────────────────────────────────
# Adapted from the FORGE OSINT pattern; each phase is env-gated so operators
# can turn them on individually once they have a labelled entity graph to
# work against.
#
# Phone enrichment (src/pipeline/phone_enrichment.py) — parses phone_match
# signals with the `phonenumbers` lib and attaches country/carrier/line-type
# to identity_signals.metadata. Fully offline; defaults on.
PHONE_ENRICHMENT_ENABLED=1

# Email breach check (src/pipeline/email_breach.py) — XposedOrNot public API
# lookup per tracked email. Emits IDENTITY_BREACHED alerts and stores hits
# in email_breach_findings. Rate-controlled per EMAIL_BREACH_MAX_PER_RUN.
EMAIL_BREACH_CHECK_ENABLED=1
EMAIL_BREACH_MAX_PER_RUN=50
EMAIL_BREACH_SLEEP_SECONDS=1.2
EMAIL_BREACH_API_TIMEOUT=15

# Sherlock handle fanout (src/pipeline/handle_fanout.py) — for each entity's
# known username, query 400+ sites via `sherlock` CLI. Slow (~2-5 min per
# username), so HANDLE_FANOUT_MAX_PER_RUN=3 caps entities per cycle
# (~36/day at 2h scheduler cadence). Results staged in handle_discoveries
# for operator review, not auto-promoted to entity_platform_links.
HANDLE_FANOUT_ENABLED=1
HANDLE_FANOUT_MAX_PER_RUN=3
HANDLE_FANOUT_TIMEOUT_S=300

# Holehe email-recognition (src/pipeline/email_recognition.py) — for each
# tracked email, check 100+ services silently via `holehe` CLI. Similar
# cadence caveats as Sherlock; HOLEHE_MAX_PER_RUN=3 per cycle.
HOLEHE_ENABLED=1
HOLEHE_MAX_PER_RUN=3
HOLEHE_TIMEOUT_S=180

# ─────────────────────────────────────────────
# ALERT RULES
# ─────────────────────────────────────────────
SILENCE_GAP_DYNAMIC=true
SILENCE_GAP_MIN_HISTORY_DAYS=14
SILENCE_GAP_FIXED_DAYS=7
SILENCE_GAP_DYNAMIC_MULTIPLIER=2.5
SILENCE_GAP_MIN_DAYS=3
SILENCE_GAP_MAX_DAYS=30

NEW_ACTIVITY_AFTER_SILENCE_ENABLED=true
NEW_ACTIVITY_EVENT_TYPES=CONTENT_PUBLISHED,MESSAGE_SENT,PHYSICAL_ACTIVITY,CODE_COMMIT,VIDEO_PUBLISHED

PROFILE_CHANGE_ALERT_ENABLED=true

# ─────────────────────────────────────────────
# API / UI
# ─────────────────────────────────────────────
# The docker stack publishes the dashboard on host port 8002 (8001 is the
# collector dashboard). Set API_PORT=8002 to match docker/docker-compose.yml.
API_PORT=8002
API_HOST=0.0.0.0

# ─────────────────────────────────────────────
# DRIVE FACE-SCANNING (face_worker)
# ─────────────────────────────────────────────
# SMB credentials for the W:/X: network drives (Tailscale host Prawn-E14),
# consumed by the CIFS volumes in docker/docker-compose.yml. Keep real values
# only in .env (gitignored), never here. NOTE: DRIVE_SOURCES / EXCLUDE_PATHS are
# set directly in the compose file, not here. C: must NEVER be a drive source
# (reading OneDrive placeholders hydrates them and fills the disk).
SMB_HOST=100.92.164.125
SMB_USER=you@example.com
SMB_PASS=changeme
# Drive-scan cadence inside the face_worker loop:
FACE_WORKER_DRIVE_BATCH=200
FACE_WORKER_DRIVE_INTERVAL=3600

# ─────────────────────────────────────────────
# FACE_WORKER CPU CONTAINMENT (shared box)
# ─────────────────────────────────────────────
# face_worker is the heaviest CPU consumer; these keep it from saturating a box
# shared with the collector stack. Applied via docker-compose (recreate, no
# rebuild needed for the compose knobs).
FACE_WORKER_MAX_CPUS=2.0   # hard cgroup ceiling (cores) — the guaranteed cap
FACE_WORKER_THREADS=2      # OMP/MKL/OpenBLAS/numexpr thread cap
FACE_ONNX_THREADS=2        # ONNXRuntime intra-op thread cap (read by the detector)

# ─────────────────────────────────────────────
# AXIS-3 FACE LOOP CLOSURE (purity guards, drive-face kNN, face_pair_knn,
# resumable drive scan). All optional — sensible defaults are hard-coded, these
# knobs let you tighten/loosen without a rebuild.
# ─────────────────────────────────────────────
# Change-1: cluster propagation purity guards (face_clustering.py).
# 2nd-nearest guard: reject propagation when ANY competing bridged entity has a
# face at least this cosine-close to a cluster anchor (defends siblings/lookalikes).
FACE_PURITY_2ND_NEAREST_THRESHOLD=0.55
# Tightness guard: reject when the anchor faces themselves disagree — the tightest
# anchor-to-anchor cosine falls below this, meaning the cluster is a single-linkage
# chain rather than one person.
FACE_PURITY_MIN_TIGHTNESS=0.35

# Change-2: drive-face kNN cross-ref (face_clustering.propagate_drive_faces_via_knn).
# Top-1 cosine gate for accepting an anchor entity as the drive face's owner.
FACE_DRIVE_XREF_THRESHOLD=0.55
# Clear-winner margin: top-2 must be at least this far below top-1 (or top-1's
# entity must match top-2's) to accept.
FACE_DRIVE_XREF_TOP_MARGIN=0.05
# Max orphan drive faces to kNN per pass — bounds one cycle's cost.
FACE_DRIVE_XREF_BATCH=5000

# Change-3: cross-entity face_pair_knn signal (face_pair_signals.py).
# Cosine threshold for counting a portrait-vs-portrait match.
FACE_PAIR_KNN_THRESHOLD=0.55
# Minimum number of portrait-pair matches required before we emit a signal —
# defends against a single impostor hit (sibling / doppelganger).
FACE_PAIR_KNN_MIN_MATCHES=2
# Cap on portrait faces per entity fed into the pairwise math; keeps O(n_a*n_b)
# bounded even for entities with hundreds of bridged faces.
FACE_PAIR_KNN_MAX_FACES_PER_ENTITY=20

# Change-4: resumable drive-scan cursor (face_worker.ingest_drive_media).
# Checkpoint the (mtime, path) cursor to drive_scan_state every N successful
# files. Higher = less DB churn; lower = less work re-done after a crash.
DRIVE_SCAN_STATE_CHECKPOINT_EVERY=100


# ─────────────────────────────────────────────
# AXIS-1 SEMANTIC TIMELINE SEARCH
# Sentence-embeds timeline_events.title via multilingual-e5-small ONNX and
# indexes into timeline_embeddings (side table, pgvector HNSW). Powers
# GET /api/search/timeline and the cross-entity `topical_similarity` signal.
# All optional — sensible defaults are hard-coded, these let you tune without
# a rebuild.
# ─────────────────────────────────────────────
# Where the ONNX + tokenizer files land on first use. Defaults to
# ${MEDIA_DERIVED_PATH}/models/text_embedder — inside the compose image that
# resolves to /app/media_derived/models/text_embedder (bind-mounted from
# Z:/unifiedanalyzer/media_derived/models/text_embedder on the host).
# TEXT_EMBED_MODEL_PATH=

# Per-batch text embedding size. 32 is a sweet spot on CPU — smaller batches
# waste tokenizer overhead, larger batches don't fit in L2 on this box.
TEXT_EMBED_BATCH=32

# ONNXRuntime intra-op threads for the text embedder. Same guard as
# FACE_ONNX_THREADS — this box shares CPU across analyzer + face_worker +
# collector, so cap at 2 to avoid saturating the box.
TEXT_EMBED_ONNX_THREADS=2

# Per-pipeline-cycle cap on how many new timeline events the content_embedding
# phase processes. The full backfill of 6.28M rows should be run offline via
# `python -m src.main embed-backfill`; this cap keeps the scheduler cycle
# small (~1-2 min) so the pipeline doesn't wedge on the initial catch-up.
TEXT_EMBED_BATCH_PER_RUN=5000

# Cross-entity topical_similarity signal (src/pipeline/topical_similarity.py).
# Cosine threshold for emitting the signal. Deliberately high — topical overlap
# is common among peers, so we only emit above 0.85 (the weight in the scorer
# is a further 0.15 attenuation, so this signal alone can't drive a merge).
TOPICAL_SIMILARITY_THRESHOLD=0.85

# Cap on timeline embeddings averaged into each entity's topical centroid.
# Uses the most recent K events; keeps the O(E * K) group-by cost bounded on
# entities with tens of thousands of rows.
TOPICAL_MAX_EVENTS_PER_ENTITY=200

# ─────────────────────────────────────────────
# MULTILINGUAL NLP + BOUNDED TRANSLATION
# Language profiles are analyzer-owned side evidence in
# timeline_language_profiles. Translation rows are context only; sentiment
# scored from translated text is marked machine_translated and should not be
# treated as stronger evidence than the original message.
# Heavy translation packages are intentionally optional. Install
# requirements-nlp.txt only on workers that run translation backfills.
# ─────────────────────────────────────────────
# fastText LID model path. Recommended CPU-light model is lid.176.ftz; leave
# blank to use the built-in fallback detector.
# FASTTEXT_LID_MODEL_PATH=
LANGUAGE_ID_MIN_CONFIDENCE=0.65
LANGUAGE_ID_CODE_MIX_SECONDARY_CONFIDENCE=0.25

# Default is noop/off. Set TRANSLATION_PROVIDER=opus-mt after installing
# requirements-nlp.txt and warming model cache. NLLB is broader but heavier and
# should stay disabled unless explicitly needed.
TRANSLATION_PROVIDER=noop
TRANSLATION_TARGET_LANGUAGE=en
TRANSLATION_MAX_PER_RUN=500
TRANSLATION_MAX_LENGTH=512
TRANSLATION_OPUS_MODEL_PREFIX=Helsinki-NLP/opus-mt
TRANSLATION_ENABLE_NLLB=0
# TRANSLATION_NLLB_MODEL=facebook/nllb-200-distilled-600M

# ─────────────────────────────────────────────
# NER ENRICHMENT + SHARED_LIFE_CONTEXT (2026-07-08)
# ─────────────────────────────────────────────
# spaCy transformer NER over each entity's bios + recent timeline event
# titles. Extracted PERSON/ORG/GPE/LOC counts are stored to
# entities.metadata->'enrichment'; the model is baked into the container
# via docker/Dockerfile.dashboard (`python -m spacy download en_core_web_trf`).
# Fully offline at runtime.
ENTITY_ENRICHMENT_ENABLED=0
# Model name — override only if you swap to a smaller variant like
# en_core_web_sm (~50MB) for dev boxes. Downstream code has no other coupling
# to the specific model beyond the label ontology (PERSON/ORG/GPE/LOC).
NER_MODEL=en_core_web_trf
# Text budget fed to spaCy per entity. 20k chars ≈ 5k tokens — well under
# transformer max_length, enough for a decade of bios + recent titles.
NER_MAX_CHARS_PER_ENTITY=20000
# Per-cycle cap on entities enriched. Refreshed every 7 days (via
# metadata->>'enriched_at' staleness), so at 100/cycle × ~12 cycles/day the
# initial catch-up on a graph of 1k entities takes ~1 day, then steady-state
# is just the stale ones.
NER_ENTITY_BATCH_PER_RUN=100

# Cross-entity shared_life_context signal (src/pipeline/shared_life_context.py).
# When two entities share an ORG or LOC that appears in <= this fraction of
# ALL enriched entities, emit a signal. 0.05 = 5%. Higher = noisier (a shared
# 'Singapore' or 'Google' becomes evidence); lower = stricter (only truly
# small orgs/schools).
SHARED_LIFE_CONTEXT_ENABLED=1
SHARED_LIFE_CONTEXT_RARITY=0.05


# ─────────────────────────────────────────────
# FACE SOCIAL GRAPH (2026-07-08)
# Two pipeline phases (src/pipeline/face_associations.py +
# src/pipeline/social_face_link.py). face_associations resolves each entity's
# primary_face_id then walks the entity's owned collector media to record
# co-appearing (associate) faces; social_face_link then emits an identity
# signal whenever another entity's primary face matches one of those
# associates at high cosine. Both phases are bounded per pass and idempotent
# via UNIQUE constraints + delete-then-insert.
# ─────────────────────────────────────────────
# Cap on collector media items processed per face_associations pass. The next
# pass picks up the rest — ON CONFLICT DO NOTHING keeps repeats safe.
FACE_ASSOCIATIONS_MAX_MEDIA=2000
# Cosine threshold used inside face_associations to identify the entity's OWN
# face among a media item's detected faces (all other faces become associates
# iff at least one face clears this bar).
FACE_ASSOCIATIONS_THRESHOLD=0.55

# social_face_link phase toggle (default on — signal is capped + delete-then-
# insert, so an accidental run is cheap to recover from).
SOCIAL_FACE_LINK_ENABLED=1
# Cosine gate for emitting a social_face_link identity signal: B's primary
# face must be at least this close to any of A's stored face_association
# embeddings. Same 0.55 threshold as face_associations for symmetry.
SOCIAL_FACE_LINK_THRESHOLD=0.55
# Hard cap on signals emitted per pass — highest-confidence pairs kept first,
# so the truncation is deterministic across restarts.
SOCIAL_FACE_LINK_MAX_PAIRS=500
